public class test13{
    public static void main(String []args)
    {
        int []a=new int[5];
        for(int i=0;i<5;i++)
        {
            a[i]=Integer.parseInt(args[i]);
        }
        boolean flag=true;
        for(int j=0;j<5;j++)
        {
            for(int k=j+1;k<5;k++)
            {
            int col1=j;
            int col2=k;
            int row1=a[j];
            int row2=a[k];
            if((row1==row2) || (col1+row1==col2+row2) || (row1-col1==row2-col2))
            {
                flag=false;
                break;
            }
        }
        }
        if(flag==false)
        {
            System.out.println("unsafe");
        }
        else{
            System.out.println("safe");
        }
    }
}
