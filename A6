public class test6{
    public static void main(String []args)
    {
        int t=Integer.parseInt(args[0]);
        double x=1;
        double x1=1;
        while(x1<t)
        {
            x1=x-(x*x-t)/(2*x);
            if(Math.abs(x1*x1-t)<1e-12)
            {
                System.out.println(x1);
                break;
            }
            x=x1;
        }

    }
}
