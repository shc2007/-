                "text": "真实调用讯飞TTS接口：基于 Java 11+ HttpClient WebSocket 与 HMAC 签名的原生请求\r\n    private double[] callXunfeiTTS(String text) {\r\n        System.out.println(\"正在请求讯飞API合成: \" + text);\r\n        try {\r\n            // 从配置文件读取配置 (路径需要与实际运行环境匹配)\r\n            Properties prop = new Properties();\r\n            prop.load(new FileInputStream(\"d:/java面向对象程序设计/Lab4/音频处理/podcast/src/main/resources/config.properties\"));\r\n            String appId = prop.getProperty(\"APPID\");\r\n            String apiSecret = prop.getProperty(\"APISecret\");\r\n            String apiKey = prop.getProperty(\"APIKey\");\r\n\r\n            if (appId == null || apiSecret == null || apiKey == null || appId.startsWith(\"你的\")) {\r\n                System.err.println(\"错误：请在 config.properties 中配置真实的 APPID, APISecret, APIKey！\");\r\n                return new double[0];\r\n            }\r\n\r\n            // 1. 生成鉴权URL并转换为wss协议\r\n            String url = getAuthUrl(\"https://tts-api.xfyun.cn/v2/tts\", apiKey, apiSecret)\r\n                    .replace(\"https://\", \"wss://\").replace(\"http://\", \"ws://\");\r\n\r\n            List<byte[]> audioChunks = new ArrayList<>();\r\n            CountDownLatch checkEnd = new CountDownLatch(1);\r\n\r\n            // 2. 初始化 WebSocket 客户端\r\n            HttpClient client = HttpClient.newHttpClient();\r\n            WebSocket.Builder builder = client.newWebSocketBuilder();\r\n            WebSocket webSocket = builder.buildAsync(URI.create(url), new WebSocket.Listener() {\r\n                StringBuilder buffer = new StringBuilder();\r\n\r\n                @Override\r\n                public void onOpen(WebSocket webSocket) {\r\n                    // 构造 JSON 请求体并发给讯飞\r\n                    String b64Text = Base64.getEncoder().encodeToString(text.getBytes(StandardCharsets.UTF_8));\r\n                    String requestJson = String.format(\r\n                            \"{\\n\" +\r\n                            \"  \\\"common\\\": {\\\"app_id\\\": \\\"%s\\\"},\\n\" +\r\n                            \"  \\\"business\\\": {\\\"aue\\\": \\\"raw\\\", \\\"auf\\\": \\\"audio/L16;rate=16000\\\", \\\"vcn\\\": \\\"xiaoyan\\\", \\\"tte\\\": \\\"utf8\\\"},\\n\" +\r\n                            \"  \\\"data\\\": {\\\"status\\\": 2, \\\"text\\\": \\\"%s\\\"}\\n\" +\r\n                            \"}\", appId, b64Text);\r\n                    webSocket.sendText(requestJson, true);\r\n                    WebSocket.Listener.super.onOpen(webSocket);\r\n                }\r\n\r\n                @Override\r\n                public CompletionStage<?> onText(WebSocket webSocket, CharSequence data, boolean last) {\r\n                    buffer.append(data);\r\n                    if (last) {\r\n                        try {\r\n                            String response = buffer.toString();\r\n                            buffer.setLength(0); // 清空\r\n                            // 用简单正则抽取出code, audio (Base64格式), 和status\r\n                            Matcher codeMatcher = Pattern.compile(\"\\\"code\\\"\\\\s*:\\\\s*(\\\\d+)\").matcher(response);\r\n                            if (codeMatcher.find() && !\"0\".equals(codeMatcher.group(1))) {\r\n                                System.err.println(\"讯飞接口返回错误: \" + response);\r\n                                checkEnd.countDown();\r\n                                return null;\r\n                            }\r\n                            \r\n                            Matcher audioMatcher = Pattern.compile(\"\\\"audio\\\"\\\\s*:\\\\s*\\\"([^\\\"]+)\\\"\").matcher(response);\r\n                            if (audioMatcher.find()) {\r\n                                String audioB64 = audioMatcher.group(1);\r\n                                byte[] pcmChunk = Base64.getDecoder().decode(audioB64);\r\n                                synchronized (audioChunks) { \r\n                                    audioChunks.add(pcmChunk); \r\n                                }\r\n                            }\r\n                            \r\n                            Matcher statusMatcher = Pattern.compile(\"\\\"status\\\"\\\\s*:\\\\s*(\\\\d+)\").matcher(response);\r\n                            if (statusMatcher.find() && \"2\".equals(statusMatcher.group(1))) {\r\n                                checkEnd.countDown(); // 处理完毕\r\n                            }\r\n                        } catch (Exception e) {\r\n                            System.err.println(\"音频流解析异常: \" + e.getMessage());\r\n                            checkEnd.countDown();\r\n                        }\r\n                    }\r\n                    return WebSocket.Listener.super.onText(webSocket, data, last);\r\n                }\r\n\r\n                @Override\r\n                public CompletionStage<?> onClose(WebSocket webSocket, int statusCode, String reason) {\r\n                    checkEnd.countDown();\r\n                    return WebSocket.Listener.super.onClose(webSocket, statusCode, reason);\r\n                }\r\n            }).join();\r\n\r\n            // 阻塞等待接收完所有分片\r\n            checkEnd.await();\r\n\r\n            // 3. 组合并重采样至 44100Hz\r\n            return processAndResample(audioChunks, 16000, SAMPLE_RATE);\r\n\r\n        } catch (Exception e) {\r\n            e.printStackTrace();\r\n            System.err.println(\"调用讯飞接口完全异常！\");\r\n        }\r\n        return new double[0];\r\n    }\r\n    \r\n    // 生成讯飞接口的鉴权URL\r\n    private static String getAuthUrl(String hostUrl, String apiKey, String apiSecret) throws Exception {\r\n        java.net.URL url = new java.net.URL(hostUrl);\r\n        SimpleDateFormat format = new SimpleDateFormat(\"EEE, dd MMM yyyy HH:mm:ss z\", Locale.US);\r\n        format.setTimeZone(TimeZone.getTimeZone(\"GMT\"));\r\n        String date = format.format(new Date());\r\n\r\n        String signatureOrigin = \"host: \" + url.getHost() + \"\\ndate: \" + date + \"\\nGET \" + url.getPath() + \" HTTP/1.1\";\r\n        Mac mac = Mac.getInstance(\"HmacSHA256\");\r\n        mac.init(new SecretKeySpec(apiSecret.getBytes(StandardCharsets.UTF_8), \"HmacSHA256\"));\r\n        String signature = Base64.getEncoder().encodeToString(mac.doFinal(signatureOrigin.getBytes(StandardCharsets.UTF_8)));\r\n\r\n        String authorizationOrigin = String.format(\"api_key=\\\"%s\\\", algorithm=\\\"%s\\\", headers=\\\"%s\\\", signature=\\\"%s\\\"\",\r\n                apiKey, \"hmac-sha256\", \"host date request-line\", signature);\r\n        String authorization = Base64.getEncoder().encodeToString(authorizationOrigin.getBytes(StandardCharsets.UTF_8));\r\n\r\n        return String.format(\"%s?authorization=%s&date=%s&host=%s\",\r\n                hostUrl,\r\n                URLEncoder.encode(authorization, StandardCharsets.UTF_8),\r\n                URLEncoder.encode(date, StandardCharsets.UTF_8),\r\n                url.getHost());\r\n    }\r\n\r\n    // PCM转Double及插值重采样 (例如 16000Hz -> 44100Hz)\r\n    private static double[] processAndResample(List<byte[]> chunks, int sourceRate, int targetRate) {\r\n        // 计算总长度\r\n        int totalLen = 0;\r\n        for (byte[] c : chunks) totalLen += c.length;\r\n        if (totalLen == 0) return new double[0];\r\n        \r\n        byte[] allBytes = new byte[totalLen];\r\n        int offset = 0;\r\n        for (byte[] c : chunks) {\r\n            System.arraycopy(c, 0, allBytes, offset, c.length);\r\n            offset += c.length;\r\n        }\r\n\r\n        // 把 16-bit PCM (小端) 转为 double[]，归一化到 [-1.0, 1.0]\r\n        int srcSamples = allBytes.length / 2;\r\n        double[] srcAudio = new double[srcSamples];\r\n        for (int i = 0; i < srcSamples; i++) {\r\n            short sample = (short) ((allBytes[i * 2] & 0xFF) | (allBytes[i * 2 + 1] << 8));\r\n            srcAudio[i] = sample / 32768.0;\r\n        }\r\n\r\n        // 线性插值重采样\r\n        int targetSamples = (int) ((long) srcSamples * targetRate / sourceRate);\r\n        double[] targetAudio = new double[targetSamples];\r\n        for (int i = 0; i < targetSamples; i++) {\r\n            double srcIndex = (double) i * sourceRate / targetRate;\r\n            int leftIndex = (int) Math.floor(srcIndex);\r\n            int rightIndex = Math.min(leftIndex + 1, srcSamples - 1);\r\n            double fraction = srcIndex - leftIndex;\r\n            // 线性插值计算\r\n            targetAudio[i] = srcAudio[leftIndex] * (1.0 - fraction) + srcAudio[rightIndex] * fraction;\r\n        }\r\n        return target",
