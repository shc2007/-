t.URL(hostUrl);\\n        SimpleDateFormat format = new SimpleDateFormat(\\\"EEE, dd MMM yyyy HH:mm:ss z\\\", Locale.US);\\n        format.setTimeZone(TimeZone.getTimeZone(\\\"GMT\\\"));\\n        String date = format.format(new Date());\\n\\n        String signatureOrigin = \\\"host: \\\" + url.getHost() + \\\"\\\\ndate: \\\" + date + \\\"\\\\nGET \\\" + url.getPath() + \\\" HTTP/1.1\\\";\\n        Mac mac = Mac.getInstance(\\\"HmacSHA256\\\");\\n        mac.init(new SecretKeySpec(apiSecret.getBytes(StandardCharsets.UTF_8), \\\"HmacSHA256\\\"));\\n        String signature = Base64.getEncoder().encodeToString(mac.doFinal(signatureOrigin.getBytes(StandardCharsets.UTF_8)));\\n\\n        String authorizationOrigin = String.format(\\\"api_key=\\\\\\\"%s\\\\\\\", algorithm=\\\\\\\"%s\\\\\\\", headers=\\\\\\\"%s\\\\\\\", signature=\\\\\\\"%s\\\\\\\"\\\",\\n                apiKey, \\\"hmac-sha256\\\", \\\"host date request-line\\\", signature);\\n        String authorization = Base64.getEncoder().encodeToString(authorizationOrigin.getBytes(StandardCharsets.UTF_8));\\n\\n        return String.format(\\\"%s?authorization=%s\\u0026date=%s\\u0026host=%s\\\",\\n                hostUrl,\\n                URLEncoder.encode(authorization, StandardCharsets.UTF_8),\\n                URLEncoder.encode(date, StandardCharsets.UTF_8),\\n                url.getHost());\\n    }\\n\\n    // PCM转Double及插值重采样 (例如 16000Hz -\\u003e 44100Hz)\\n    private static double[] processAndResample(List\\u003cbyte[]\\u003e chunks, int sourceRate, int targetRate) {\\n        // 计算总长度\\n        int totalLen = 0;\\n        for (byte[] c : chunks) totalLen += c.length;\\n        if (totalLen == 0) return new double[0];\\n        \\n        byte[] allBytes = new byte[totalLen];\\n        int offset = 0;\\n        for (byte[] c : chunks) {\\n            System.arraycopy(c, 0, allBytes, offset, c.length);\\n            offset += c.length;\\n        }\\n\\n        // 把 16-bit PCM (小端) 转为 double[]，归一化到 [-1.0, 1.