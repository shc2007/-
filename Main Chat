+) {\n                switch (args[i]) {\n                    case \"-i\":\n                        if (i + 1 < args.length) inputfile = args[++i];\n                        break;\n                    case \"-o\":\n                        if (i + 1 < args.length) outputfile = args[++i];\n                        break;\n                    case \"-t\":\n                        if (i + 1 < args.length) templatefile = args[++i];\n                        break;\n                }\n            }\n\n            CleanMailer mailer = new CleanMailer();\n            // Test3 expects read from cleaned list, generating emails.txt with just emails, and outputting mail text for each.\n            if (inputfile != null && templatefile != null) {\n                // 读取完整(formal格式)信息\n                String[] lines = Clean.getAllLinesFromFile(inputfile);\n                List<CleanMailer.Recipient> recipients = new ArrayList<>();\n                for (String line : lines) {\n                    String[] parts = line.split(\",\");\n                    if (parts.length == 3) {\n                        recipients.add(new CleanMailer.Recipient(parts[0], parts[1], parts[2]));\n                    }\n                }\n                \n                // 写 emails.txt 和控制台内容\n                StringBuilder emailListStr = new StringBuilder();\n                StringBuilder mailOutputStr = new StringBuilder();\n                \n                String template = \"\";\n                try {\n                    template = new String(java.nio.file.Files.readAllBytes(java.nio.file.Paths.get(templatefile)), \"UTF-8\");\n                } catch (Exception e) {}\n\n                // Replace \\r\\n with \\n to normalize template before replacement\n                template = template.replace(\"\\r\\n\", \"\\n\");\n\n                for (int j = 0; j < recipients.size(); j++) {\n                    CleanMailer.Recipient r = recipients.get(j);\n                    emailListStr.append(r.email.toLow