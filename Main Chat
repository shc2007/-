                "text": "package org.example;\n\nimport java.io.*;\nimport java.nio.file.Files;\nimport java.nio.file.Paths;\nimport java.text.SimpleDateFormat;\nimport java.util.*;\n\npublic class CleanMailer {\n    \n    public static class Recipient {\n        public String name;\n        public String email;\n        public String city;\n\n        public Recipient(String name, String email, String city) {\n            this.name = name;\n            this.email = email;\n            this.city = city;\n        }\n    }\n\n    private List<Recipient> recipientList = new ArrayList<>();\n    private String emailTemplate = \"\";\n\n    /**\n     * Read方法实现从Clean导出后的通讯录或名单中读取收件人列表。\n     * 支持 csv (name,email,city) 格式或 单独邮箱(email) 格式\n     */\n    public void readRecipients(String filePath, String mode) {\n        String[] lines = Clean.getAllLinesFromFile(filePath);\n        for (String line : lines) {\n            line = line.trim();\n            if (line.isEmpty()) continue;\n            \n            if (\"clean\".equals(mode)) {\n                // 读取完整(formal格式)信息\n                String[] parts = line.split(\",\");\n                if (parts.length == 3) {\n                    recipientList.add(new Recipient(parts[0], parts[1], parts[2]));\n                }\n            } else if (\"emails\".equals(mode)) {\n                // 如果只有邮箱，其他字段暂留空或做占位符\n                recipientList.add(new Recipient(\"User\", line, \"Unknown\"));\n            }\n        }\n    }\n\n    /**\n     * 设置邮件模板，从文件读取\n     */\n    public void loadTemplate(String templatePath) {\n        StringBuilder sb = new StringBuilder();\n        try (BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(templatePath), \"UTF-8\"))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                sb.append(line).append(System.lineSeparator());\n            }\n            this.emailTemplate = sb.toString();\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    /**\n     * Replace方法：给定邮件模板并进行简单个性化替换\n     */\n    public String replacePlaceholders(Recipient recipient) {\n        if (emailTemplate == null || emailTemplate.isEmpty()) return \"\";\n        \n        String content = emailTemplate;\n        content = content.replace(\"{name}\", recipient.name);\n        content = content.replace(\"{email}\", recipient.email);\n        content = content.replace(\"{city}\", recipient.city);\n        return content;\n    }\n\n    /**\n     * sentlog方法实现：生成一份发送记录\n     */\n    public void sentlog(String logPath, String recipientEmail, String subject, boolean success, String reason) {\n        String timestamp = new SimpleDateFormat(\"yyyy-MM-dd HH:mm:ss\").format(new Date());\n        String resStr = success ? \"成功\" : (\"失败: \" + reason);\n        String logEntry = String.format(\"[%s] 收件人:%s, 主题:%s, 结果:%s\", timestamp, recipientEmail, subject, resStr);\n        \n        try (PrintWriter pw = new PrintWriter(new OutputStreamWriter(new FileOutputStream(logPath, true), \"UTF-8\"))) {\n            pw.println(logEntry);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    /**\n     * ways方法实现：安全策略\n     * 简单的去重保护和黑名单功能\n     */\n    public boolean waysCheck(Recipient r, Set<String> sentEmails, Set<String> blackList) {\n        if (blackList != null && blackList.contains(r.email.toLowerCase())) {\n            return false; // 在黑名单\n        }\n        if (sentEmails.contains(r.email.toLowerCase())) {\n            return false; // 已经发过了，去重保护\n        }\n        return true;\n    }\n\n    /**\n     * Review方法实现：把即将发送的邮件都生成到本地(或标准输出)而不真的发送，便于人工检查\n     * 按照题目样例，这里我们只是将内容合并输出或者打印\n     */\n    public void review(String outputFile) {\n        try (PrintWriter pw = new PrintWriter(new OutputStreamWriter(new FileOutputStream(outputFile), \"UTF-8\"))) {\n            for (Recipient r : recipientList) {\n                String emailContent = replacePlaceholders(r);\n                pw.print(emailContent);\n                pw.println(\"--------------------------------------------------\"); // 或不加分割，视要求而定\n            }\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n    }\n\n    /**\n     * Send方法实现：将所有处理好的邮件群发给所有收件人\n     * 综合运用 Read, Replace, ways, sentlog 等\n     */\n    public void send(String logPath) {\n        Set<String> sentEmails = new HashSet<>();\n        Set<String> blacklist = new HashSet<>(); // 可扩充黑名单加载逻辑\n        \n        for (Recipient r : recipientList) {\n            if (waysCheck(r, sentEmails, blacklist)) {\n                String finalContent = replacePlaceholders(r);\n                // 模拟发送\n                // System.out.println(\"向 \" + r.email + \" 发送：\\n\" + finalContent);\n                \n                // 发送成功，记录日志\n                String subjectExtract = extractSubject(finalContent);\n                sentlog(logPath, r.email, subjectExtract, true, \"\");\n                sentEmails.add(r.email.toLowerCase());\n            } else {\n                sentlog(logPath, r.email, \"未知\", false, \"触发安全策略拦截(黑名单/重复录入)\");\n            }\n        }\n    }\n\n    /**\n     * 辅助方法：从模板中提取Subject做日志\n     * 例如 \"Subject: Club Notice: Welcome Alice\" -> 提取后面那段\n     */\n    private String extractSubject(String content) {\n        try (BufferedReader br = new BufferedReader(new StringReader(content))) {\n            String line;\n            while ((line = br.readLine()) != null) {\n                if (line.startsWith(\"Subject:\")) {\n                    return line.substring(\"Subject:\".length()).trim();\n                }\n            }\n        } catch (Exception e) {}\n        return \"No Subject\";\n    }\n\n    /**\n     * 用于生成测试用例3中的邮件文本流\n     */\n    public void generateIndividualEmails(String masterEmailFile) {\n        // 为了方便测试3，我们也可以一次性合并写入\n        // 测试3只要求看到内容，具体是否生成单独文件或者终端输出需要看样例执行要求\n        for (Recipient r : recipientList) {\n            System.out.println(replacePlaceholders(r));\n        }\n    }\n}\n",
