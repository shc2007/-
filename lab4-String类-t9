import java.io.*;
import java.util.ArrayList;
public class test{
    public static void main(String []args)
    {
       String inputfile="9.txt";
       String outputfile="9output.txt";
       String [] inpuStrings=getAllLinesFromFile(inputfile);
       String maxn=inpuStrings[0],minn=inpuStrings[0];
       for(int i=1;i<inpuStrings.length;i++)
       {
        if(maxn.compareTo(inpuStrings[i])<0)
        {
            maxn=inpuStrings[i];
        }
        if(minn.compareTo(inpuStrings[i])>0)
        {
            minn=inpuStrings[i];
        }
       }
       writeStringToFile((maxn), outputfile);
       writeStringToFile(("\n"), outputfile);
       writeStringToFile((minn), outputfile);
    }
    public static String[] getAllLinesFromFile(String fileName){
        int numLines = 0;
        BufferedReader br = null;
        ArrayList<String> strList = new ArrayList<String>();
        try {
            br = new BufferedReader(new InputStreamReader(new FileInputStream(fileName), "UTF-8"));

            String temp = null;
            while((temp = br.readLine()) != null){  
                strList.add(temp);
            }
            numLines = strList.size();
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try {
                br.close();
            } catch (Exception e) {
                e.printStackTrace();
            }
        }
        String[] res = new String[numLines];
        for(int i  = 0; i < numLines; i++) {
            res[i] = strList.get(i);
        }
		return res;
	}
    public static void writeStringToFile(String str, String fileName) {
		BufferedWriter bw = null;
        try {
            bw = new BufferedWriter(new OutputStreamWriter(new FileOutputStream(fileName, true), "UTF-8"));
            bw.write(str);
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try {
                bw.close();
            } catch (Exception e) {
                e.printStackTrace();
            }
        }
    }
}
