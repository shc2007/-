public class test12{
    public static void main(String []args)
    {
        int n=Integer.parseInt(args[0]);
        int []a=new int[n];
        for(int i=0;i<n;i++)
        {
            a[i]=Integer.parseInt(args[i+1]);
        }
        String s="";
        for(int j=1;j<=n;j++)
        {
            for(int k=0;k<n;k++)
            {
                if(a[k]==j)
                {
                    s+=(k+1);
                    if(j<n) s+=" ";
                    break;
                }
            }
        }
        System.out.println(s);
    }
}
